{
  "name": "spell-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simulador do sistema mágico de Witch Hat Atelier — compõe glyphs por arrasto e reconhece/valida spells.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.js\"",
    "vectorize:sigils": "node tools/vectorize-sigils.cjs",
    "vectorize:signs": "node tools/vectorize-signs.cjs",
    "unknown:report": "node tools/unknown-report.cjs",
    "facts": "node tools/spell-engine-cli.mjs --facts",
    "render": "node tools/render.mjs",
    "ai": "node tools/ai-bridge.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "konva": "^9.3.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "potrace": "^2.1.8",
    "supabase": "^2.104.0",
    "vite": "^5.4.11"
  }
}
