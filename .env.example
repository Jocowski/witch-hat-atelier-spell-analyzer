# Spell Studio — environment template. Copy to `.env` and fill from `npx supabase status`.
# Vite only exposes vars prefixed with VITE_ to the browser. NEVER put the service_role key here.

# Local Supabase (from `npx supabase status`):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local anon key printed by `supabase start` / `supabase status`>

# Local AI bridge (npm run ai). In prod this becomes your tunnel URL.
VITE_AI_BRIDGE_URL=http://localhost:8787
