node_modules/
dist/
.vite/
*.log
.DS_Store

# Local manga mirror + reader (downloaded images are copyrighted — never commit)
manga/

# Scratch dir: working renders, JSON drafts, pasted source dumps
tmp/

# Secrets — never commit real keys (.env.example is the committed template)
.env
.env.local

# Supabase local stack runtime (config.toml + migrations/ + seed.sql ARE committed)
supabase/.branches/
supabase/.temp/

.claude/

# Vendored agent skills (regenerable from skills-lock.json; uses symlinks that don't port cross-OS)
.agents/

# Local-only prod DB connection string (never commit)
supabase/.prod-conn

# ML toolchain (dev-only; never imported by app/tests/CI)
# Generated training images and model checkpoints are large and reproducible.
ml/data/images/
ml/data/labels.json
ml/data/omniglot/
ml/checkpoints/*.pt
