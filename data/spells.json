{
  "$schema": "./schema/spells.schema.json",
  "version": "1.0.0",
  "title": "Spell Recipe Database",
  "description": "Each spell is a 'recipe': core (sigil or central sign) + a set of signs with count/placement/orientation + symmetry. The matcher compares the user's composition against these recipes. 'composition' uses: { core, signs:[{id,count,placement,orientation,inverted}], symmetry }. placement ∈ {around, top, bottom, sides, front, back, ring, alternating, surrounds, satellite}. confidence indicates how well the glyph is known in the source material.",
  "placementVocab": [
    "around",
    "alternating",
    "ring",
    "surrounds",
    "top",
    "bottom",
    "sides",
    "front",
    "back",
    "satellite",
    "center"
  ],
  "symmetryVocab": [
    "radial",
    "bilateral",
    "asymmetric"
  ],
  "spells": [
    {
      "id": "purify",
      "name": "Purify",
      "category": "water",
      "origin": "canon",
      "confidence": "high",
      "effect": "Draws in wastewater and separates the impurities out of it; the contaminants pile up near the seal, leaving the water clean.",
      "composition": {
        "core": "water",
        "signs": [
          { "id": "purify", "count": 10, "placement": "around", "orientation": "outward", "inverted": false },
          { "id": "collection", "count": 2, "placement": "sides", "orientation": "outward", "inverted": false }
        ],
        "symmetry": "radial"
      }
    },
